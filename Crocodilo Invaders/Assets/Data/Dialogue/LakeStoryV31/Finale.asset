    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "Ent\xE3o deixa eu abrir o canal."
    expressionId: determined
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: Segura os pequenos!
    expressionId: vulnerable
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "Segura a\xED. Eu abro do lado!"
    expressionId: determined
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 1.5
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: channel
  - speakerId: saperereca
    speakerName: 
    text: "T\xE1 baixando. Devagar."
    expressionId: relieved
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: Tu podia ter levado a barragem inteira.
    expressionId: vulnerable
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "A gente precisa dessa \xE1gua viva."
    expressionId: sincere
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: O canal fica aberto.
    expressionId: serious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: saperereca
    speakerName: 
    text: "E voc\xEAs seguram a sucata l\xE1 de cima."
    expressionId: firm
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: Vou cobrar dos pilotos.
    expressionId: neutral
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: Cobra com juros.
    expressionId: proud
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: Essa eu deixei pra tu.
