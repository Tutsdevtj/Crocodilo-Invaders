  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 661aa54ffdd7ae546b6ad3e9dc243230, type: 3}
  m_Name: Encounter
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  cast: {fileID: 11400000, guid: b2de6a34dbd8c744eb6c3d0cf84a2233, type: 2}
  openDelay: 0.25
  closeDelay: 0.2
  lines:
  - speakerId: sapeneu
    speakerName: 
    text: "Desliga essa geringon\xE7a. T\xE1 espantando minha comida."
    expressionId: proud
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "Tu t\xE1 segurando a \xE1gua que abastece a base."
    expressionId: serious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: "T\xF4 segurando coisa pior."
    expressionId: serious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: "A \xFAltima m\xE1quina que passou deixou isso aqui."
    expressionId: serious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "Tem gente precisando dessa \xE1gua."
    expressionId: sincere
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: "Aqui tamb\xE9m tem."
    expressionId: serious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "O canal do lado t\xE1 entupido. D\xE1 pra abrir uma passagem."
    expressionId: determined
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: "Come\xE7a abrindo um buraco. Quando eu vejo, levaram minha margem inteira."
    expressionId: furious
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "O rio j\xE1 t\xE1 escolhendo onde vai ceder."
    expressionId: worried
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: sapeneu
    speakerName: 
    text: "Ent\xE3o \xE9 bom tu sair de cima dele."
    expressionId: proud
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
    glimpseExpressionId: 
    beat: 
  - speakerId: crocodilo
    speakerName: 
    text: "\xD4! A mosca t\xE1 ATR\xC1S de mim!"
    expressionId: alert
    pauseBefore: 0
    pauseStyle: 0
    pauseAfter: 0.15
    soundOverride: {fileID: 0}
    startSound: {fileID: 0}
    startSoundVolume: 0.5
    effect: 0
    glimpseSpeakerId: 
